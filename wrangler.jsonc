{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crowns-and-commons",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only these paths reach the Worker; everything else is served as a static file.
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  // Append-only. SQLite-backed Durable Objects are the kind available on the free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }]
}
